# OpenAgents Stock Analysis System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration (Optional - for LLM-powered analysis)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Network Configuration (Optional - override defaults)
# NETWORK_PORT=8700
# NETWORK_HOST=localhost

# Logging Configuration
# LOG_LEVEL=INFO

# Data Cache Configuration
# CACHE_DIR=./data/cache
# CACHE_TTL_SECONDS=86400

# WebSocket Proxy Configuration
# WS_PORT=8702
# MCP_URL=http://localhost:8700/mcp

# Note: Never commit .env file to version control!
# Add .env to .gitignore to keep your secrets safe.

